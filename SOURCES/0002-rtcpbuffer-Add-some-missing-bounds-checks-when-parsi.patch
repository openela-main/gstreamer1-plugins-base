From 41e6c2335de502bf6688953cc297fea663f3b12e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Sebastian=20Dr=C3=B6ge?= <sebastian@centricular.com>
Date: Tue, 2 Jun 2026 17:52:06 +0300
Subject: [PATCH 2/3] rtcpbuffer: Add some missing bounds checks when parsing
 SDES

Fixes https://gitlab.freedesktop.org/gstreamer/gstreamer/-/work_items/5047

Part-of: <https://gitlab.freedesktop.org/gstreamer/gstreamer/-/merge_requests/11791>
---
 .../gst-libs/gst/rtp/gstrtcpbuffer.c          |  75 +++-
 .../gst-plugins-base/tests/check/libs/rtp.c   | 416 ++++++++++++++++++
 2 files changed, 471 insertions(+), 20 deletions(-)

diff --git a/subprojects/gst-plugins-base/gst-libs/gst/rtp/gstrtcpbuffer.c b/subprojects/gst-plugins-base/gst-libs/gst/rtp/gstrtcpbuffer.c
index 12d321d4fd..9e9eb81477 100644
--- a/subprojects/gst-plugins-base/gst-libs/gst/rtp/gstrtcpbuffer.c
+++ b/subprojects/gst-plugins-base/gst-libs/gst/rtp/gstrtcpbuffer.c
@@ -1250,6 +1250,8 @@ gst_rtcp_packet_sdes_get_item_count (GstRTCPPacket * packet)
 gboolean
 gst_rtcp_packet_sdes_first_item (GstRTCPPacket * packet)
 {
+  guint len;
+
   g_return_val_if_fail (packet != NULL, FALSE);
   g_return_val_if_fail (packet->type == GST_RTCP_TYPE_SDES, FALSE);
 
@@ -1260,6 +1262,13 @@ gst_rtcp_packet_sdes_first_item (GstRTCPPacket * packet)
   if (packet->count == 0)
     return FALSE;
 
+  /* don't overrun - use total packet size */
+  len = (packet->length + 1) << 2;
+
+  /* need at least space for the SSRC and one entry */
+  if (packet->item_offset + packet->entry_offset + 4 > len)
+    return FALSE;
+
   return TRUE;
 }
 
@@ -1295,8 +1304,8 @@ gst_rtcp_packet_sdes_next_item (GstRTCPPacket * packet)
   /* skip SSRC */
   offset += 4;
 
-  /* don't overrun */
-  len = (packet->length << 2);
+  /* don't overrun - use total packet size */
+  len = (packet->length + 1) << 2;
 
   while (offset < len) {
     if (data[offset] == 0) {
@@ -1304,9 +1313,13 @@ gst_rtcp_packet_sdes_next_item (GstRTCPPacket * packet)
       offset = (offset + 4) & ~3;
       break;
     }
+    if (offset + 1 >= len)
+      return FALSE;
     offset += data[offset + 1] + 2;
   }
-  if (offset >= len)
+
+  /* needs at least SSRC and one item plus padding */
+  if (offset + 4 + 4 > len)
     return FALSE;
 
   packet->item_offset = offset;
@@ -1328,7 +1341,7 @@ guint32
 gst_rtcp_packet_sdes_get_ssrc (GstRTCPPacket * packet)
 {
   guint32 ssrc;
-  guint8 *data;
+  const guint8 *data;
 
   g_return_val_if_fail (packet != NULL, 0);
   g_return_val_if_fail (packet->type == GST_RTCP_TYPE_SDES, 0);
@@ -1337,11 +1350,18 @@ gst_rtcp_packet_sdes_get_ssrc (GstRTCPPacket * packet)
 
   /* move to SDES */
   data = packet->rtcp->map.data;
-  data += packet->offset;
+  guint offset = packet->offset;
   /* move to item */
-  data += packet->item_offset;
+  offset += packet->item_offset;
 
-  ssrc = GST_READ_UINT32_BE (data);
+  /* don't overrun - use total packet size */
+  guint len = (packet->length + 1) << 2;
+
+  /* needs at least SSRC and one item plus padding */
+  if (offset + 4 + 4 > len)
+    return 0;
+
+  ssrc = GST_READ_UINT32_BE (data + offset);
 
   return ssrc;
 }
@@ -1375,14 +1395,18 @@ gst_rtcp_packet_sdes_first_entry (GstRTCPPacket * packet)
 
   packet->entry_offset = 4;
 
-  /* don't overrun */
-  len = (packet->length << 2);
+  /* don't overrun - use total packet size */
+  len = (packet->length + 1) << 2;
   if (offset >= len)
     return FALSE;
 
   if (data[offset] == 0)
     return FALSE;
 
+  /* need at least id, length and padding */
+  if (offset + 4 > len)
+    return FALSE;
+
   return TRUE;
 }
 
@@ -1413,8 +1437,8 @@ gst_rtcp_packet_sdes_next_entry (GstRTCPPacket * packet)
   /* move to entry */
   offset += packet->entry_offset;
 
-  /* don't overrun - check before reading item_len */
-  len = (packet->length << 2);
+  /* don't overrun - use total packet size */
+  len = (packet->length + 1) << 2;
   if (offset + 1 >= len)
     return FALSE;
 
@@ -1432,6 +1456,15 @@ gst_rtcp_packet_sdes_next_entry (GstRTCPPacket * packet)
   if (data[offset] == 0)
     return FALSE;
 
+  /* need at least id and length */
+  if (offset + 1 >= len)
+    return FALSE;
+
+  /* validate the full entry fits */
+  item_len = data[offset + 1] + 2;
+  if (offset + item_len > len)
+    return FALSE;
+
   return TRUE;
 }
 
@@ -1472,21 +1505,23 @@ gst_rtcp_packet_sdes_get_entry (GstRTCPPacket * packet,
   /* move to entry */
   offset += packet->entry_offset;
 
-  /* Warn if potentially accessing out of bounds */
-  guint pkt_len = (packet->length << 2);
-  if (offset + 1 >= pkt_len) {
-    GST_WARNING ("SDES entry offset %u exceeds packet length %u", offset,
-        pkt_len);
+  /* use total packet size */
+  guint pkt_len = (packet->length + 1) << 2;
+  if (offset + 2 >= pkt_len)
+    return FALSE;
+
+  guint item_type = bdata[offset];
+  if (item_type == 0)
     return FALSE;
-  }
 
-  if (bdata[offset] == 0)
+  guint item_length = bdata[offset + 1];
+  if (offset + 2 + item_length > pkt_len)
     return FALSE;
 
   if (type)
-    *type = bdata[offset];
+    *type = item_type;
   if (len)
-    *len = bdata[offset + 1];
+    *len = item_length;
   if (data)
     *data = &bdata[offset + 2];
 
diff --git a/subprojects/gst-plugins-base/tests/check/libs/rtp.c b/subprojects/gst-plugins-base/tests/check/libs/rtp.c
index f423d0b27f..35862886d6 100644
--- a/subprojects/gst-plugins-base/tests/check/libs/rtp.c
+++ b/subprojects/gst-plugins-base/tests/check/libs/rtp.c
@@ -2388,6 +2388,412 @@ GST_START_TEST (test_sdes_parsing_out_of_bounds)
 
 GST_END_TEST;
 
+GST_START_TEST (test_sdes_parsing_valid_single_item)
+{
+  /* Valid SDES packet with a single item containing CNAME */
+  GstRTCPBuffer rtcp = GST_RTCP_BUFFER_INIT;
+  GstRTCPPacket packet;
+  GstBuffer *buffer;
+  guint8 sdes_data[] = {
+    0x81, 0xca, 0x00, 0x05,     /* V=2, P=0, RC=1, PT=SDES, length=5 (24 bytes) */
+    0x12, 0x34, 0x56, 0x78,     /* SSRC */
+    0x01, 0x0a,                 /* CNAME, length=10 */
+    't', 'e', 's', 't', '@', 'f', 'o', 'o', '.', 'b',
+    0x00,                       /* End of SDES */
+    0x00, 0x00, 0x00            /* Padding */
+  };
+
+  buffer = gst_buffer_new_and_alloc (sizeof (sdes_data));
+  gst_buffer_fill (buffer, 0, sdes_data, sizeof (sdes_data));
+
+  fail_unless (gst_rtcp_buffer_map (buffer, GST_MAP_READ, &rtcp));
+  fail_unless (gst_rtcp_buffer_get_first_packet (&rtcp, &packet));
+  fail_unless_equals_int (gst_rtcp_packet_get_type (&packet),
+      GST_RTCP_TYPE_SDES);
+
+  /* Get SSRC */
+  fail_unless_equals_int (gst_rtcp_packet_sdes_get_ssrc (&packet), 0x12345678);
+
+  /* Iterate items */
+  fail_unless (gst_rtcp_packet_sdes_first_item (&packet));
+
+  /* Iterate entries */
+  fail_unless (gst_rtcp_packet_sdes_first_entry (&packet));
+  {
+    guint8 *data;
+    guint8 len;
+    GstRTCPSDESType type;
+
+    fail_unless (gst_rtcp_packet_sdes_get_entry (&packet, &type, &len, &data));
+    fail_unless_equals_int (type, GST_RTCP_SDES_CNAME);
+    fail_unless_equals_int (len, 10);
+    fail_unless (memcmp (data, "test@foo.b", 10) == 0);
+  }
+  /* END marker is not an entry */
+  fail_if (gst_rtcp_packet_sdes_next_entry (&packet));
+  fail_if (gst_rtcp_packet_sdes_next_item (&packet));
+
+  gst_rtcp_buffer_unmap (&rtcp);
+  gst_buffer_unref (buffer);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_sdes_parsing_valid_single_item_multiple_entries)
+{
+  /* Valid SDES packet with a single item containing CNAME and NOTE */
+  GstRTCPBuffer rtcp = GST_RTCP_BUFFER_INIT;
+  GstRTCPPacket packet;
+  GstBuffer *buffer;
+  guint8 sdes_data[] = {
+    0x81, 0xca, 0x00, 0x06,     /* V=2, P=0, RC=1, PT=SDES, length=6 (28 bytes) */
+    0x12, 0x34, 0x56, 0x78,     /* SSRC */
+    0x01, 0x0a,                 /* CNAME, length=10 */
+    't', 'e', 's', 't', '@', 'f', 'o', 'o', '.', 'b',
+    0x07, 0x02, 'a', 'b',       /* NOTE, length=2 */
+    0x00,                       /* End of SDES */
+    0x00, 0x00, 0x00            /* Padding */
+  };
+
+  buffer = gst_buffer_new_and_alloc (sizeof (sdes_data));
+  gst_buffer_fill (buffer, 0, sdes_data, sizeof (sdes_data));
+
+  fail_unless (gst_rtcp_buffer_map (buffer, GST_MAP_READ, &rtcp));
+  fail_unless (gst_rtcp_buffer_get_first_packet (&rtcp, &packet));
+  fail_unless_equals_int (gst_rtcp_packet_get_type (&packet),
+      GST_RTCP_TYPE_SDES);
+
+  /* Get SSRC */
+  fail_unless_equals_int (gst_rtcp_packet_sdes_get_ssrc (&packet), 0x12345678);
+
+  /* Iterate items */
+  fail_unless (gst_rtcp_packet_sdes_first_item (&packet));
+
+  /* Iterate entries */
+  fail_unless (gst_rtcp_packet_sdes_first_entry (&packet));
+  {
+    guint8 *data;
+    guint8 len;
+    GstRTCPSDESType type;
+
+    fail_unless (gst_rtcp_packet_sdes_get_entry (&packet, &type, &len, &data));
+    fail_unless_equals_int (type, GST_RTCP_SDES_CNAME);
+    fail_unless_equals_int (len, 10);
+    fail_unless (memcmp (data, "test@foo.b", 10) == 0);
+
+    fail_unless (gst_rtcp_packet_sdes_next_entry (&packet));
+    fail_unless (gst_rtcp_packet_sdes_get_entry (&packet, &type, &len, &data));
+    fail_unless_equals_int (type, GST_RTCP_SDES_NOTE);
+    fail_unless_equals_int (len, 2);
+    fail_unless (memcmp (data, "ab", 2) == 0);
+  }
+  /* END marker is not an entry */
+  fail_if (gst_rtcp_packet_sdes_next_entry (&packet));
+  fail_if (gst_rtcp_packet_sdes_next_item (&packet));
+
+  gst_rtcp_buffer_unmap (&rtcp);
+  gst_buffer_unref (buffer);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_sdes_parsing_valid_multiple_items)
+{
+  /* Valid SDES packet with two items */
+  GstRTCPBuffer rtcp = GST_RTCP_BUFFER_INIT;
+  GstRTCPPacket packet;
+  GstBuffer *buffer;
+  guint8 sdes_data[] = {
+    0x82, 0xca, 0x00, 0x08,     /* V=2, P=0, RC=2, PT=SDES, length=8 (36 bytes) */
+    /* Item 1: SSRC=0x11111111, CNAME="sender1" */
+    0x11, 0x11, 0x11, 0x11,     /* SSRC */
+    0x01, 0x07, 's', 'e', 'n', 'd', 'e', 'r', '1',      /* CNAME: 9 bytes */
+    0x00,                       /* END marker */
+    0x00, 0x00,                 /* Pad item 1 to 16 bytes */
+    /* Item 2: SSRC=0x22222222, CNAME="sender2" */
+    0x22, 0x22, 0x22, 0x22,     /* SSRC */
+    0x01, 0x07, 's', 'e', 'n', 'd', 'e', 'r', '2',      /* CNAME: 9 bytes */
+    0x00,                       /* END marker */
+    0x00, 0x00                  /* Pad to 36 bytes total */
+  };
+
+  buffer = gst_buffer_new_and_alloc (sizeof (sdes_data));
+  gst_buffer_fill (buffer, 0, sdes_data, sizeof (sdes_data));
+
+  fail_unless (gst_rtcp_buffer_map (buffer, GST_MAP_READ, &rtcp));
+  fail_unless (gst_rtcp_buffer_get_first_packet (&rtcp, &packet));
+
+  /* Item 1 */
+  fail_unless (gst_rtcp_packet_sdes_first_item (&packet));
+  fail_unless_equals_int (gst_rtcp_packet_sdes_get_ssrc (&packet), 0x11111111);
+  fail_unless (gst_rtcp_packet_sdes_first_entry (&packet));
+  {
+    guint8 *data;
+    guint8 len;
+    GstRTCPSDESType type;
+    fail_unless (gst_rtcp_packet_sdes_get_entry (&packet, &type, &len, &data));
+    fail_unless_equals_int (type, GST_RTCP_SDES_CNAME);
+    fail_unless_equals_int (len, 7);
+    fail_unless (memcmp (data, "sender1", 7) == 0);
+  }
+  /* END marker is not an entry */
+  fail_if (gst_rtcp_packet_sdes_next_entry (&packet));
+
+  /* Item 2 */
+  fail_unless (gst_rtcp_packet_sdes_next_item (&packet));
+  fail_unless_equals_int (gst_rtcp_packet_sdes_get_ssrc (&packet), 0x22222222);
+  fail_unless (gst_rtcp_packet_sdes_first_entry (&packet));
+  {
+    guint8 *data;
+    guint8 len;
+    GstRTCPSDESType type;
+    fail_unless (gst_rtcp_packet_sdes_get_entry (&packet, &type, &len, &data));
+    fail_unless_equals_int (type, GST_RTCP_SDES_CNAME);
+    fail_unless_equals_int (len, 7);
+    fail_unless (memcmp (data, "sender2", 7) == 0);
+  }
+  /* END marker is not an entry */
+  fail_if (gst_rtcp_packet_sdes_next_entry (&packet));
+
+  /* No more items */
+  fail_if (gst_rtcp_packet_sdes_next_item (&packet));
+
+  gst_rtcp_buffer_unmap (&rtcp);
+  gst_buffer_unref (buffer);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_sdes_parsing_valid_multiple_items_multiple_entries)
+{
+  /* Valid SDES packet with two items */
+  GstRTCPBuffer rtcp = GST_RTCP_BUFFER_INIT;
+  GstRTCPPacket packet;
+  GstBuffer *buffer;
+  guint8 sdes_data[] = {
+    0x82, 0xca, 0x00, 0x0A,     /* V=2, P=0, RC=2, PT=SDES, length=10 (44 bytes) */
+    /* Item 1: SSRC=0x11111111, CNAME="sender1" */
+    0x11, 0x11, 0x11, 0x11,     /* SSRC */
+    0x01, 0x07, 's', 'e', 'n', 'd', 'e', 'r', '1',      /* CNAME: 9 bytes */
+    0x07, 0x02, 'a', 'b',       /* NOTE: 2 bytes */
+    0x00,                       /* END marker */
+    0x00, 0x00,                 /* Pad item 1 to 16 bytes */
+    /* Item 2: SSRC=0x22222222, CNAME="sender2" */
+    0x22, 0x22, 0x22, 0x22,     /* SSRC */
+    0x01, 0x07, 's', 'e', 'n', 'd', 'e', 'r', '2',      /* CNAME: 9 bytes */
+    0x07, 0x02, 'a', 'b',       /* NOTE: 2 bytes */
+    0x00,                       /* END marker */
+    0x00, 0x00                  /* Pad to 36 bytes total */
+  };
+
+  buffer = gst_buffer_new_and_alloc (sizeof (sdes_data));
+  gst_buffer_fill (buffer, 0, sdes_data, sizeof (sdes_data));
+
+  fail_unless (gst_rtcp_buffer_map (buffer, GST_MAP_READ, &rtcp));
+  fail_unless (gst_rtcp_buffer_get_first_packet (&rtcp, &packet));
+
+  /* Item 1 */
+  fail_unless (gst_rtcp_packet_sdes_first_item (&packet));
+  fail_unless_equals_int (gst_rtcp_packet_sdes_get_ssrc (&packet), 0x11111111);
+  fail_unless (gst_rtcp_packet_sdes_first_entry (&packet));
+  {
+    guint8 *data;
+    guint8 len;
+    GstRTCPSDESType type;
+    fail_unless (gst_rtcp_packet_sdes_get_entry (&packet, &type, &len, &data));
+    fail_unless_equals_int (type, GST_RTCP_SDES_CNAME);
+    fail_unless_equals_int (len, 7);
+    fail_unless (memcmp (data, "sender1", 7) == 0);
+  }
+
+  /* Item 2, skip over remaining entry of item 1 */
+  fail_unless (gst_rtcp_packet_sdes_next_item (&packet));
+  fail_unless_equals_int (gst_rtcp_packet_sdes_get_ssrc (&packet), 0x22222222);
+  fail_unless (gst_rtcp_packet_sdes_first_entry (&packet));
+  {
+    guint8 *data;
+    guint8 len;
+    GstRTCPSDESType type;
+    fail_unless (gst_rtcp_packet_sdes_get_entry (&packet, &type, &len, &data));
+    fail_unless_equals_int (type, GST_RTCP_SDES_CNAME);
+    fail_unless_equals_int (len, 7);
+    fail_unless (memcmp (data, "sender2", 7) == 0);
+
+    fail_unless (gst_rtcp_packet_sdes_next_entry (&packet));
+    fail_unless (gst_rtcp_packet_sdes_get_entry (&packet, &type, &len, &data));
+    fail_unless_equals_int (type, GST_RTCP_SDES_NOTE);
+    fail_unless_equals_int (len, 2);
+    fail_unless (memcmp (data, "ab", 2) == 0);
+  }
+  /* END marker is not an entry */
+  fail_if (gst_rtcp_packet_sdes_next_entry (&packet));
+
+  /* No more items */
+  fail_if (gst_rtcp_packet_sdes_next_item (&packet));
+
+  gst_rtcp_buffer_unmap (&rtcp);
+  gst_buffer_unref (buffer);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_sdes_parsing_truncated_entry)
+{
+  /* SDES item with only SSRC and no entry data at all */
+  GstRTCPBuffer rtcp = GST_RTCP_BUFFER_INIT;
+  GstRTCPPacket packet;
+  GstBuffer *buffer;
+  guint8 sdes_data[] = {
+    0x81, 0xca, 0x00, 0x01,     /* length=1 (8 bytes payload) */
+    0x12, 0x34, 0x56, 0x78,     /* SSRC */
+    /* No entry data - truncated */
+  };
+
+  buffer = gst_buffer_new_and_alloc (sizeof (sdes_data));
+  gst_buffer_fill (buffer, 0, sdes_data, sizeof (sdes_data));
+
+  fail_unless (gst_rtcp_buffer_map (buffer, GST_MAP_READ, &rtcp));
+  fail_unless (gst_rtcp_buffer_get_first_packet (&rtcp, &packet));
+
+  /* first_item should fail, so get_ssrc should also fail */
+  fail_if (gst_rtcp_packet_sdes_first_item (&packet));
+  /* get_ssrc on a packet without a valid item should return 0 */
+  fail_unless_equals_int (gst_rtcp_packet_sdes_get_ssrc (&packet), 0);
+  /* Should fail: no space for entry type + length */
+  fail_if (gst_rtcp_packet_sdes_first_entry (&packet));
+  fail_if (gst_rtcp_packet_sdes_get_entry (&packet, NULL, NULL, NULL));
+
+  gst_rtcp_buffer_unmap (&rtcp);
+  gst_buffer_unref (buffer);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_sdes_parsing_truncated_entry_data)
+{
+  /* Entry declares length=5 but only 2 bytes of data available */
+  GstRTCPBuffer rtcp = GST_RTCP_BUFFER_INIT;
+  GstRTCPPacket packet;
+  GstBuffer *buffer;
+  guint8 sdes_data[] = {
+    0x81, 0xca, 0x00, 0x02,     /* length=2 (12 bytes payload) */
+    0x12, 0x34, 0x56, 0x78,     /* SSRC */
+    0x01, 0x05,                 /* CNAME, length=5 */
+    'a', 'b'                    /* Only 2 bytes of data, but length says 5 */
+  };
+
+  buffer = gst_buffer_new_and_alloc (sizeof (sdes_data));
+  gst_buffer_fill (buffer, 0, sdes_data, sizeof (sdes_data));
+
+  fail_unless (gst_rtcp_buffer_map (buffer, GST_MAP_READ, &rtcp));
+  fail_unless (gst_rtcp_buffer_get_first_packet (&rtcp, &packet));
+
+  fail_unless (gst_rtcp_packet_sdes_first_item (&packet));
+  fail_unless_equals_int (gst_rtcp_packet_sdes_get_ssrc (&packet), 0x12345678);
+  fail_unless (gst_rtcp_packet_sdes_first_entry (&packet));
+  /* Should fail: entry is truncated */
+  fail_if (gst_rtcp_packet_sdes_get_entry (&packet, NULL, NULL, NULL));
+
+  /* No other item */
+  fail_if (gst_rtcp_packet_sdes_next_item (&packet));
+
+  gst_rtcp_buffer_unmap (&rtcp);
+  gst_buffer_unref (buffer);
+}
+
+GST_END_TEST;
+
+GST_START_TEST (test_sdes_parsing_next_item_truncated)
+{
+  /* Two items where the second is truncated (not enough space for SSRC + entry) */
+  GstRTCPBuffer rtcp = GST_RTCP_BUFFER_INIT;
+  GstRTCPPacket packet;
+  GstBuffer *buffer;
+  guint8 sdes_data[] = {
+    0x82, 0xca, 0x00, 0x04,     /* length=4 (20 bytes payload) */
+    /* Item 1: complete */
+    0x11, 0x11, 0x11, 0x11,     /* SSRC */
+    0x01, 0x05, 'a', 'b', 'c', 'd', 'e',
+    0x00,
+    /* Item 2: truncated - only SSRC, no entries */
+    0x22, 0x22, 0x22, 0x22      /* SSRC only */
+  };
+
+  buffer = gst_buffer_new_and_alloc (sizeof (sdes_data));
+  gst_buffer_fill (buffer, 0, sdes_data, sizeof (sdes_data));
+
+  fail_unless (gst_rtcp_buffer_map (buffer, GST_MAP_READ, &rtcp));
+  fail_unless (gst_rtcp_buffer_get_first_packet (&rtcp, &packet));
+
+  /* Item 1 is valid */
+  fail_unless (gst_rtcp_packet_sdes_first_item (&packet));
+  fail_unless_equals_int (gst_rtcp_packet_sdes_get_ssrc (&packet), 0x11111111);
+  fail_unless (gst_rtcp_packet_sdes_first_entry (&packet));
+  {
+    guint8 *data;
+    guint8 len;
+    GstRTCPSDESType type;
+    fail_unless (gst_rtcp_packet_sdes_get_entry (&packet, &type, &len, &data));
+    fail_unless_equals_int (type, GST_RTCP_SDES_CNAME);
+    fail_unless_equals_int (len, 5);
+  }
+  /* END marker is not an entry */
